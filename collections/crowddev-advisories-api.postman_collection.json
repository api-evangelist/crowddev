  "item": [
    {
      "id": "da4e11dc-0d90-41c3-99a8-d109740163fa",
      "name": "Advisories",
      "description": {
        "content": "Security advisories for a package, split out of package detail. The draft contract gates these behind a dedicated read:advisories scope; until Auth0 issues it, the implementation reuses read:packages (advisories need no stewardship read). Confirm the final scope name (read:advisories vs cdp:advisories:read) with Akrites/product.\n",
        "type": "text/plain"
      },
