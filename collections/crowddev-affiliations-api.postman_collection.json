        {
          "id": "dfd16919-6b28-450a-a52f-4dc75240d4fe",
          "name": "Bulk contributor lookup",
          "request": {
            "name": "Bulk contributor lookup",
            "description": {
              "content": "Look up affiliation data for up to 100 GitHub handles in a single request. Handles that have no matching LFX profile are returned in the `notFound` array.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "affiliations"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number (1-based)."
                },
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "20",
                  "description": "Number of contributors to return per page."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"githubHandles\": [\n    \"<string>\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
