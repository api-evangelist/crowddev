{
  "opencollection": "1.0.0",
  "info": {
    "name": "CDP → Akrites External Advisories Maintainer Roles API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://linuxfoundation.auth0.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Maintainer Roles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List maintainer roles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cm.lfx.dev/api/v1/members/:memberId/maintainer-roles",
            "params": [
              {
                "name": "memberId",
                "value": "",
                "type": "path",
                "description": "UUID of the member."
              }
            ]
          },
          "docs": "Retrieve all maintainer roles for a member across projects."
        }
      ]
    }
  ],
  "bundled": true
}