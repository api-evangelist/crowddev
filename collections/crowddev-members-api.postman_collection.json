                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lfids\": [\n    \"<string>\"\n  ],\n  \"emails\": [\n    \"<email>\",\n    \"<email>\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
