          "name": "Create a member profile",
          "request": {
            "name": "Create a member profile",
            "description": {
              "content": "Create a new member profile in CDP with one or more identities.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "members"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"<string>\",\n  \"identities\": [\n    {\n      \"value\": \"<string>\",\n      \"platform\": \"<string>\",\n      \"type\": \"<string>\",\n      \"source\": \"<string>\",\n      \"verified\": \"<boolean>\",\n      \"verifiedBy\": \"<string>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
