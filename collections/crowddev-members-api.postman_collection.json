        {
          "id": "23d50431-d77c-4bda-b3d9-fea54b1045ce",
          "name": "Resolve a CDP member profile",
          "request": {
            "name": "Resolve a CDP member profile",
            "description": {
              "content": "Resolve memberId from identities. LFX One should always make a first request to this API to retrieve the corresponding memberId from CDP. If a member is found, use it. If not, create a member.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "members",
                "resolve"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
